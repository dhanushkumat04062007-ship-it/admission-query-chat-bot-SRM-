# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file.

# MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=university_admission_db

# Server
PORT=5000

# Auth - use long random strings
SESSION_SECRET=change_me_to_a_long_random_string
JWT_SECRET=change_me_to_a_long_random_string

# Admin console login (leave empty to disable admin login)
ADMIN_USERNAME=
ADMIN_KEY=

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
